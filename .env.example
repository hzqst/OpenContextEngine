# Source installation template. npm users can run: open-context-engine setup
# Copy to .env and fill in your model service settings.

EMBEDDING_BASE_URL=https://embedding.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B
# Must match your endpoint's actual output dimensions.
OCE_EMBEDDING_DIMENSIONS=2560

# Base URL before /rerank; include /v1 only if your provider requires it.
RERANK_BASE_URL=https://rerank.example.com/v1
RERANK_API_KEY=
RERANK_MODEL=Qwen3-Reranker-4B

# Optional configuration: docs/QUICKSTART.md
# Extra file suffixes to keep out of the index, e.g. documentation. Empty by default.
# OCE_EXCLUDE_SUFFIXES=.md,.mdx
# Idle seconds before a worker exits and releases its repository writer lock. Zero keeps it.
# OCE_WORKER_IDLE_SECONDS=300
